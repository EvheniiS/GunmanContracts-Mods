<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fixture for Mod Settings' Updated defaults page. Variant=Old (1.0.0, default) or New (1.1.0). Built by Test-Defaults.ps1. -->
  <Import Project="..\..\ModSettings\GameDir.local.props" Condition="Exists('..\..\ModSettings\GameDir.local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>DefaultsTest</AssemblyName>
    <RootNamespace>DefaultsTest</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gunman Contracts - Stand Alone</GameDir>
    <MLDir>$(GameDir)\MelonLoader\net6</MLDir>
    <DefineConstants Condition="'$(Variant)' == 'New'">$(DefineConstants);NEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(MLDir)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MLDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
